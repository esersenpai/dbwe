# /etc/nginx/sites-enabled/dbwe  (Kap. 13.3.8)
# Nginx nimmt Anfragen auf Port 80 entgegen und leitet sie an Gunicorn weiter
server {
    listen 80;
    server_name _;
    access_log /var/log/dbwe_access.log;
    error_log  /var/log/dbwe_error.log;

    location / {
        proxy_pass http://localhost:8000;
        proxy_redirect off;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location /static {
        alias /home/student/dbwe/app/static;
        expires 30d;
    }
}
